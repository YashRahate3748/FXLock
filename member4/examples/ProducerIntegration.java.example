// Merge these beans/methods into the existing producer application; this is not a separate service.
// Add event-contract and the Eureka client dependency from config/client-dependencies.xml.
@Bean
OutboxAppender outboxAppender(JdbcTemplate jdbc, ObjectMapper mapper) {
    return new OutboxAppender(jdbc, mapper);
}

// Public method on a Spring @Service, invoked through its Spring proxy.
@Transactional
public void completeSettlement(String paymentId, String correlationId) {
    // M3 owns payment idempotency: unique payment key + row lock/conditional state update.
    int changed = jdbc.update("UPDATE payment SET status='SETTLED' WHERE payment_id=? AND status='CONFIRMED'", paymentId);
    if (changed == 0) return; // Actual M3 code must distinguish already settled from invalid transition.
    var payload = mapper.createObjectNode().put("paymentId", paymentId).put("status", "SETTLED");
    var event = new EventEnvelope(UUID.randomUUID(), 1, "fx-settlement-completed", paymentId,
        "fx-payment-service", correlationId, Instant.now(), payload);
    outbox.append(event); // SAME JdbcTemplate/DataSource/Oracle transaction as UPDATE payment.
}
// Imports: com.example.contract.*, org.springframework.context.annotation.Bean,
// org.springframework.transaction.annotation.Transactional, org.springframework.jdbc.core.JdbcTemplate,
// tools.jackson.databind.ObjectMapper, java.util.UUID, java.time.Instant.
