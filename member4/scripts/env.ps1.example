# Copy to scripts/env.local.ps1, replace credentials, then dot-source in EACH app terminal:
# . ./scripts/env.local.ps1
$env:JAVA_HOME='C:\jdk25'
$env:PATH="$env:JAVA_HOME\bin;$env:PATH"
$env:ORACLE_URL='jdbc:oracle:thin:@//localhost:1521/FREEPDB1'
$env:ORACLE_USER='fx'
$env:ORACLE_PASSWORD='replace-with-your-oracle-password'
$env:KAFKA_BOOTSTRAP_SERVERS='localhost:9092'
$env:EUREKA_URL='http://localhost:8761/eureka/'
$env:SERVICE_HOSTNAME='localhost'
$env:OPS_USER='ops'
$env:OPS_PASSWORD='replace-with-your-operations-password'
